<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TextAndNearbySearchActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/top_bar"
        style="@style/Widget.MaterialComponents.Toolbar.Primary"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/text_and_nearby_search_button"
        app:titleTextColor="?attr/colorOnPrimary" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_small"
                android:text="@string/text_and_nearby_search_description"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/input_text_query"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/text_search_query_hint"
                android:inputType="text"
                android:text="@string/text_search_default_query" />

            <EditText
                android:id="@+id/input_center_lat_lng"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/search_center_lat_lng_hint"
                android:inputType="text"
                android:text="@string/search_default_center_lat_lng" />

            <EditText
                android:id="@+id/input_radius_meters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/search_radius_meters_hint"
                android:inputType="numberDecimal"
                android:text="@string/search_default_radius_meters" />

            <EditText
                android:id="@+id/input_included_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/search_included_type_hint"
                android:inputType="text"
                android:text="@string/search_default_included_type" />

            <CheckBox
                android:id="@+id/checkbox_open_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_open_now_label" />

            <CheckBox
                android:id="@+id/display_raw_results"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/display_raw_results" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/search_by_text_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:text="@string/search_by_text_button_label" />

                <Button
                    android:id="@+id/search_nearby_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/search_nearby_button_label" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/loading"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_small"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/response_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
